# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Base de données et file de jobs (pas encore utilisées : les jobs sont en mémoire)
DATABASE_URL=postgresql+psycopg://viralslice:viralslice@localhost:5432/viralslice
REDIS_URL=redis://localhost:6379/0

# OpenAI (Whisper, GPT-4o, TTS)
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Voix off : "openai" ou "elevenlabs"
TTS_PROVIDER=openai
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Stockage des médias : "local" ou "s3" (seul MEDIA_ROOT est utilisé pour l'instant)
STORAGE_BACKEND=local
MEDIA_ROOT=./media
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Pipeline
MAX_SOURCE_DURATION_SECONDS=3600
# Fichier cookies Netscape pour yt-dlp, souvent indispensable pour YouTube depuis un serveur
YTDLP_COOKIES_FILE=
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
VIDEO_PRESET=medium
VIDEO_CRF=20
# Volume de l'audio original sous la voix off (entre 0.20 et 0.25)
ORIGINAL_VOLUME_WITH_VOICEOVER=0.22

# Sous-titres : police (Montserrat conseillée) et dossier contenant ses fichiers .ttf
SUBTITLE_FONT=Montserrat
FONTS_DIR=
