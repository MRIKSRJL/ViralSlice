# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Base de données et file de jobs
DATABASE_URL=postgresql+psycopg://viralslice:viralslice@localhost:5432/viralslice
REDIS_URL=redis://localhost:6379/0

# OpenAI (Whisper, GPT-4o, TTS)
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Voix off : "openai" ou "elevenlabs"
TTS_PROVIDER=openai
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Stockage des médias : "local" ou "s3"
STORAGE_BACKEND=local
MEDIA_ROOT=./media
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Limites du pipeline
MAX_SOURCE_DURATION_SECONDS=3600
MAX_CLIPS_PER_JOB=5
FFMPEG_BINARY=ffmpeg
