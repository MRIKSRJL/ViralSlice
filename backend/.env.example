# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Base de données et file de jobs (pas encore utilisées : les jobs sont en mémoire)
DATABASE_URL=postgresql+psycopg://viralslice:viralslice@localhost:5432/viralslice
REDIS_URL=redis://localhost:6379/0

# Fournisseur IA (transcription Whisper au mot + choix des moments + script)
# Vide = automatique : "openai" si OPENAI_API_KEY est renseignée, sinon "groq".
# Test gratuit sans carte : laissez OPENAI_API_KEY vide et renseignez seulement GROQ_API_KEY.
AI_PROVIDER=

# Groq, offre gratuite sans carte bancaire. Clé : https://console.groq.com/keys
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
# Offre gratuite : 8 000 tokens/min pour gpt-oss, la transcription envoyée est donc réduite au-delà.
GROQ_MAX_TRANSCRIPT_CHARS=14000

# OpenAI (payant) : Whisper, GPT-4o, TTS
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Voix off : "openai", "elevenlabs" ou "edge" (edge-tts, gratuit, sans compte)
# Vide = automatique : "openai" avec OpenAI, "edge" avec Groq.
TTS_PROVIDER=
EDGE_TTS_VOICE=fr-FR-RemyMultilingualNeural
EDGE_TTS_RATE=+8%
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Stockage des médias : "local" ou "s3" (seul MEDIA_ROOT est utilisé pour l'instant)
STORAGE_BACKEND=local
MEDIA_ROOT=./media
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Pipeline
MAX_SOURCE_DURATION_SECONDS=3600
# Fichier cookies Netscape pour yt-dlp, souvent indispensable pour YouTube depuis un serveur
YTDLP_COOKIES_FILE=
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
VIDEO_PRESET=medium
VIDEO_CRF=20
# Volume de l'audio original sous la voix off (entre 0.20 et 0.25)
ORIGINAL_VOLUME_WITH_VOICEOVER=0.22

# Sous-titres : police (Montserrat conseillée) et dossier contenant ses fichiers .ttf
SUBTITLE_FONT=Montserrat
FONTS_DIR=
